# PalmSight — biến môi trường
# Copy thành .env và điền giá trị. KHÔNG commit file .env (repo công khai).
# [api] = apps/api đọc · [web] = apps/web đọc (NEXT_PUBLIC_* lộ ra trình duyệt, không đặt secret ở đó)

# ---------- Chung ----------
NODE_ENV=development
# URL công khai của web. Dev qua ngrok: https://<static-domain>.ngrok-free.app
PUBLIC_BASE_URL=http://localhost:3000
# [web] Next.js rewrite /api/v1/* sang địa chỉ này. Prod: URL của API trên Render
API_INTERNAL_URL=http://localhost:4000
# [api]
API_PORT=4000

# ---------- Database ----------
# [api] Local: replica set 1 node trong docker-compose (bắt buộc replicaSet để dùng transaction)
# Prod: chuỗi mongodb+srv:// của MongoDB Atlas
MONGODB_URI=mongodb://localhost:27017/palmsight?replicaSet=rs0&directConnection=true

# ---------- Auth ----------
# [api] chuỗi ngẫu nhiên >= 32 byte: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# [api] + [web] Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web)
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# [api] + [web] developers.facebook.com > App > Settings > Basic
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
NEXT_PUBLIC_FACEBOOK_APP_ID=

# ---------- Object storage (S3-compatible) ----------
# [api] Dev: MinIO trong docker-compose. Prod: Cloudflare R2
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=palmsight-images
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
SIGNED_URL_TTL_SECONDS=300

# ---------- AI ----------
# [api] groq | gemini
AI_PROVIDER=groq
AI_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=
# Kiểm tra tên model vision hiện hành tại console.groq.com/docs/models
AI_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
AI_FALLBACK_PROVIDER=gemini
GEMINI_API_KEY=
AI_FALLBACK_MODEL=
AI_TIMEOUT_MS=40000
AI_MAX_TOKENS=2000
AI_TEMPERATURE=0.7

# ---------- Nghiệp vụ credits / referral ----------
# [api] xem docs/business-rules.md
SIGNUP_BONUS_CREDITS=3
REFERRAL_REWARD_CREDITS=2
READING_COST_CREDITS=1
REFERRAL_DAILY_CAP=10

# ---------- Ảnh ----------
# [api] Ảnh cũ được xoá bằng lifecycle rule của bucket (90 ngày), không qua biến này
IMAGE_MAX_BYTES=8388608
IMAGE_MAX_DIMENSION=1280

# ---------- Dev tools ----------
NGROK_AUTHTOKEN=
