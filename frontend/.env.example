# PalmSight web (frontend/) — biến môi trường
# Copy thành frontend/.env và điền giá trị. KHÔNG commit file .env.
#
# Biến VITE_* được nhúng vào bundle lúc build: AI CŨNG ĐỌC ĐƯỢC. Không bao giờ đặt secret ở đây.
# Secret của server nằm ở backend/.env.example.
# Production: đặt các biến VITE_* trong phần Environment của Vercel; đổi giá trị thì phải build lại.

# ---------- Đăng nhập (công khai) ----------
# Cùng giá trị với GOOGLE_CLIENT_ID của backend
VITE_GOOGLE_CLIENT_ID=
# Cùng giá trị với FACEBOOK_APP_ID của backend
VITE_FACEBOOK_APP_ID=

# ---------- Model AI (Tùy chọn) ----------
# Đường dẫn CDN tới file palm_lines.onnx (mặc định nếu để trống sẽ tải từ R2 / /models/palm_lines.onnx)
VITE_PALM_MODEL_URL=

# ---------- Chỉ dùng khi dev (vite.config.ts đọc, không vào bundle) ----------
# Vite proxy /api/v1/* sang địa chỉ này. Prod: URL API trên Render ghi trong vercel.json
API_PROXY_TARGET=http://localhost:4000
# Domain ngrok cho server.allowedHosts, cách nhau bởi dấu phẩy. Ví dụ: palmsight-dev.ngrok-free.app
DEV_ALLOWED_HOSTS=
